# PDF 가이드 요구사항: VITE_ 접두사 환경변수 사용
# 주의: VITE_ 값은 브라우저 번들에 포함됩니다. 반드시 사용량/결제 한도가 낮은 교육용 키만 사용하세요.
VITE_OPENAI_API_KEY=
VITE_OPENAI_MODEL=gpt-5-mini

# Finder 탭 — 없으면 샘플 데이터로 자동 대체됩니다.
# 국가교통정보센터(ITS) CCTV: https://www.its.go.kr/opendata
VITE_ITS_API_KEY=
# 경찰청 실종아동정보 서비스(안전Dream): https://www.data.go.kr/data/3052083/openapi.do
VITE_SAFE182_ESNTL_ID=
VITE_SAFE182_AUTH_KEY=
